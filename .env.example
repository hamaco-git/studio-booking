# 이 파일을 .env 로 복사한 뒤 값을 바꿔서 사용합니다. (.env 는 Git에 올리지 않습니다)

# 개발(Mac): True / 운영 서버: 반드시 False
DEBUG=True

# 운영 서버에서는 아래 명령으로 만든 긴 무작위 값을 넣으세요.
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# postgres://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgres://studio:studio@localhost:5432/studio_booking

# 접속 허용 주소(쉼표로 구분). 기본값: localhost,127.0.0.1
# 운영 서버는 도메인만 적으면 됩니다. CSRF_TRUSTED_ORIGINS는 비워 두면
# https://도메인 이 자동으로 들어갑니다.
# ALLOWED_HOSTS=studio.example.ac.kr
# SECURE_COOKIES=True
#
# 직접 정해야 할 때만 (예: 다른 포트·http 주소에서 로그인 폼을 보낼 때)
# CSRF_TRUSTED_ORIGINS=https://studio.example.ac.kr

# 이 Mac의 내부망 IP와 호스트명(.local)을 자동 허용 (기본값: DEBUG와 같음)
# 운영 서버에서는 False
# LAN_ACCESS=True

# 교수 본인 예약 취소 마감: 촬영일 N일 전까지 (기본 2)
# PROFESSOR_CANCEL_DAYS_BEFORE=2
