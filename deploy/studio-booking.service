# /etc/systemd/system/studio-booking.service
[Unit]
Description=Studio booking (Gunicorn)
After=network.target postgresql.service

[Service]
User=studio
Group=www-data
WorkingDirectory=/srv/studio-booking
ExecStart=/srv/studio-booking/.venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/studio-booking/gunicorn.sock
RuntimeDirectory=studio-booking
Restart=on-failure

[Install]
WantedBy=multi-user.target
